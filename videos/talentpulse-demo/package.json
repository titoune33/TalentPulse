{
  "name": "talentpulse-demo",
  "private": true,
  "type": "module",
  "description": "Sources reproductibles de la vidéo de démonstration produit TalentPulse (30 s, FR, voix off). Hors du build Next.js.",
  "scripts": {
    "build:index": "node build-index.mjs --hyperframes .",
    "dev": "npx --yes hyperframes@0.8.34 preview",
    "check": "npx --yes hyperframes@0.8.34 check",
    "lint": "npx --yes hyperframes@0.8.34 lint",
    "snapshot": "npx --yes hyperframes@0.8.34 snapshot",
    "render": "node render.mjs",
    "publish": "node publish.mjs",
    "render:publish": "npm run render && npm run publish"
  },
  "hyperframes": {
    "cli": "0.8.34",
    "authoringSkill": "product-launch-video"
  }
}
