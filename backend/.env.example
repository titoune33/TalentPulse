# Server Configuration
PORT=8000

# Database
# Production (Render): postgresql://user:***@host:5432/talentpulse
# Local (optional, SQLite is used automatically if unset):
DATABASE_URL=postgresql://postgres:***@localhost:5432/talentpulse

# JWT Secret (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

# Token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,https://talentpulse.netlify.app

# ML model storage directory (relative to backend/)
# MODEL_DIR=data/ml

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=https://talentpulse.netlify.app

# Stripe Price IDs (à récupérer depuis le dashboard Stripe)
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# Demo account created on first boot
DEMO_EMAIL=demo@talentpulse.app
DEMO_PASSWORD=demo1234
