# ---------------------------------------------------------------------------
# TalentPulse backend — copy to .env and adjust
# ---------------------------------------------------------------------------

# JWT secret (generate with: openssl rand -hex 32)
# Leave empty in local dev: the app falls back to an insecure development key.
SECRET_KEY=

# Database URL
# Local: sqlite:///talentpulse.db
# Prod:  postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///talentpulse.db

# JWT token expiry in minutes (default: 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated list of allowed browser origins.
# The frontend origin MUST be listed here or every API call fails in the browser.
CORS_ORIGIN=http://localhost:3000,https://talentpulse.app

# Server port
PORT=8000

# Demo workspace seeded on first boot (14 talents + 182 predictions)
DEMO_EMAIL=demo@talentpulse.app
DEMO_PASSWORD=demo1234

# --- Stripe (optional) ------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to stay in demo mode: subscribing simply
# unlocks the Pro plan locally, no payment involved.
#
# In live mode, the plan is only activated by the webhook, so
# STRIPE_WEBHOOK_SECRET is required. Endpoint to declare in Stripe:
#   POST {BACKEND_URL}/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, customer.subscription.paused
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids are validated server-side against this allow-list: a client can
# never choose an arbitrary price.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Frontend URL — used for the Stripe checkout success/cancel redirects
FRONTEND_URL=http://localhost:3000
