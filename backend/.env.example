# Server Configuration
PORT=8000

# Database
# Production (Render): postgresql://user:password@host:5432/talentpulse
# Local (optional, SQLite is used automatically if unset):
DATABASE_URL=postgresql://postgres:password@localhost:5432/talentpulse

# JWT Secret (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

# Token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,https://talentpulse.netlify.app

# ML model storage directory (relative to backend/)
# MODEL_DIR=data/ml

# Demo account created on first boot
# DEMO_EMAIL=demo@talentpulse.app
# DEMO_PASSWORD=demo1234
